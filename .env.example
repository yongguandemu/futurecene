# ============================================================
# 必填环境变量模板（P0-M0，规格书 6.2 密钥管理规则）
#
# 使用方法：复制本文件为 .env 并填入真实值。
# 缺失任一变量，应用启动即打印 [config] missing required env: XXX 并退出。
# 密钥只从环境变量/.env 读取，config/ 下配置文件禁止写明文密钥。
# ============================================================

# OpenAI API Key（LLM 主引擎）
OPENAI_API_KEY=

# 智谱 AI API Key（LLM 备用引擎）
ZHIPU_API_KEY=

# 阿里云 DashScope API Key（LLM / TTS）
DASHSCOPE_API_KEY=

# 五声 TTS API Key（语音合成）
WUSOUND_API_KEY=

# B站开放平台 AccessKey ID（直播接入）
BILIBILI_ACCESS_KEY_ID=

# B站开放平台 AccessKey Secret（直播接入）
BILIBILI_ACCESS_KEY_SECRET=

# B站登录 Cookie（弹幕/直播间互动）
BILIBILI_COOKIE=

# OBS WebSocket 密码（直播场景切换）
OBS_WS_PASSWORD=
